# Copy to .env and fill in real values. Never commit .env.
# Every variable here is read through src/app/core/config.py, or by docker-compose.yml where
# a block says so. tests/test_env_example.py checks that this file lists every setting, and
# that your .env has the same variables in the same order.

# --- App ---
ENVIRONMENT=development
# Comma-separated frontend origins allowed for CORS and the refresh/logout Origin check.
CORS_ORIGINS=http://localhost:3000

# --- Local Postgres and ports (read by docker-compose.yml) ---
POSTGRES_USER=imena
POSTGRES_PASSWORD=imena
POSTGRES_DB=imena
# Host ports of the compose services. Change one if it's taken on your machine (by another
# Postgres on 5432, say); the localhost URLs below follow it.
DB_PORT=5432
DB_TEST_PORT=5433
API_PORT=8000

# --- Database (Neon in deployed environments, Docker Postgres locally) ---
# ${...} references only expand from variables defined ABOVE them in this file, so keep
# the Postgres block first. A reference to a later (or missing) variable becomes "".
# These localhost URLs are for running the API, Alembic or pytest outside Docker;
# docker-compose.yml overrides them inside its containers.
# Pooled URL, used by the app.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}
# Direct (unpooled) URL, used by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}
# Test database (`docker compose --profile test up -d db_test`). pytest uses this one,
# and its tables are created and dropped by the test run.
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_TEST_PORT}/${POSTGRES_DB}_test

# To run Alembic or the scripts against a Neon branch instead, swap these in for the two
# URLs above. Take them from Neon's console (the branch → Connect), change postgresql:// to
# postgresql+psycopg://, and keep the query string. The pooled host contains "-pooler".
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# DATABASE_URL_DIRECT=postgresql+psycopg://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# --- Auth tokens and email codes ---
# Three different values, each generated with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Signs access tokens (JWT).
ACCESS_TOKEN_SECRET=
# Keys the hash stored for each refresh token. Changing it logs every device out.
REFRESH_TOKEN_SECRET=
# Keys the hash stored for each emailed code. Changing it only invalidates codes in flight.
CODE_SECRET=
# Lifetimes in seconds: 15 minutes and 90 days.
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=7776000

# --- Google sign-in ---
# OAuth client ID of the frontend's "Sign in with Google" button (Google Cloud console →
# APIs & Services → Credentials). Not a secret. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# --- First admin (used only by the seed script) ---
# To be matched by the v1 import, use the admin's v1 family name and email.
FIRST_ADMIN_FAMILY_NAME=
FIRST_ADMIN_EMAIL=
# At least 12 characters. Remove it from .env once the admin is seeded.
FIRST_ADMIN_PASSWORD=
# HOPE, LIGHT or WIHOGORA, spelt exactly. The seed never creates a sub-family.
FIRST_ADMIN_SUB_FAMILY=

# --- v1 data import (used only by scripts/import_v1.py) ---
# v1's MongoDB connection string, including the database name (v1's is `test`). Read-only
# use; ideally a read-only database user. Remove it from .env once the import is done.
V1_MONGODB_URI=

# --- Email over SMTP (sending is off until SMTP_HOST and EMAIL_FROM are set) ---
# The sender people see, e.g. Imena NewsBox <no-reply@example.org>
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), tls (usually 465), or none for a relay on the same
# machine, which then can't take a username or password
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Sanity CMS (blog posts; the dataset is private) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Cloudinary (profile photos only) ---
# v1's photos are on the account dwzy8ynvp: use it to keep managing (and deleting) them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
