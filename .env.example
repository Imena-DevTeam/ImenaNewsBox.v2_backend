# Copy to .env and fill in real values. Never commit .env.
# Every variable here is read through src/app/core/config.py.

# --- App ---
ENVIRONMENT=development
# Comma-separated frontend origins allowed for CORS and the refresh/logout Origin check.
CORS_ORIGINS=http://localhost:3000

# --- Local Postgres (read by docker-compose.yml) ---
POSTGRES_USER=imena
POSTGRES_PASSWORD=imena
POSTGRES_DB=imena

# --- Database (Neon in deployed environments, Docker Postgres locally) ---
# The app doesn't expand ${...} references, so write the URLs out in full.
# These localhost URLs are for running the API, Alembic or pytest outside Docker;
# docker-compose.yml overrides them inside its containers.
# Pooled URL, used by the app.
DATABASE_URL=postgresql+psycopg://imena:imena@localhost:5432/imena
# Direct (unpooled) URL, used by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+psycopg://imena:imena@localhost:5432/imena

# --- Auth tokens ---
# Generate each secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Lifetimes in seconds: 15 minutes and 90 days.
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=7776000

# --- First admin (used only by the seed script) ---
FIRST_ADMIN_FAMILY_NAME=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Email (provider not chosen yet: fill in only the block for the chosen one) ---
EMAIL_FROM=
# Option A: Resend (needs a verified sending domain)
RESEND_API_KEY=
# Option B: Gmail API with a family Gmail account (OAuth app set to "In production")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Sanity CMS (blog posts; the dataset is private) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Cloudinary (profile photos only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
